page {
  height: 100vh;
  display: block;
  font-family: "Source Han Sans SC", system-ui;
  background-color: #3F3F3F;
}

.page {
  height: 100vh;
  display: block;
  font-family: "Source Han Sans SC", system-ui;
  background-color: #3F3F3F;
}

.page_main_view {
  z-index: 0;
  width: 750rpx;
  height: 100vh;
  display: flex;
}



.hidden_block {
  z-index: 0;
  width: 750rpx;
  height: 11vh;
}

/* 页标头-开始 */

.page_head {
  z-index: 100;
  position: fixed;
  display: flex;
  height: 11vh;
  width: 750rpx;
  /* background-color: #F8F8F8; */
  background-color: #262423;
  box-shadow: 0 0 2px 2px #0000004d;
  align-items: center;
}

.page_head_item {
  display: flex;
  margin-left: 30rpx;
  align-items: center;
  flex-direction: row;
}

.page_head_icon {
  border-radius: 25%;
  width: 6vh;
  height: 6vh;
}

.page_head_text_block {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin-left: 20rpx;
  font-family: "Source Han Sans SC", system-ui;
}

.page_head_main_text {
  font-weight: 500;
  color: #ffffff;
  font-size: x-large;
}

.page_head_second_text {
  font-size: xx-small;
  color: #7f7f7f;
}

/* 页标头-结束 */