/* pages/minecraft_pages/project_learn/project_learn.wxss */

.project_main_info_line {
  margin-top: 1vh;
  width: 710rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-evenly;
  /* background-color: aqua; */
  height: max-content;
  padding: 20rpx;
  box-sizing: border-box;
  border-bottom: solid 1px #34363c;
}

.project_image {
  border: solid 1px #2D2F35;
  border-radius: 8px;
  height: 10vh;
  width: 10vh;
  box-shadow: #00000040 0px 2px 4px 0px;
}

.project_main_info_first_line {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 12vh;
  width: 100%;
}

.project_main_info_first_line_right_block {
  margin-left: 0.6rem;
  height: 100%;
  width: max-content;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.project_main_info_title {
  width: 100%;
  color: #ffffff;
  font-size: 1.5rem;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}

.project_main_info_description {
  color: #B0BAC5;
  font-size: 16px;
  line-height: 1.3em;
  width: 100%;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

.project_main_info_second_line {
  height: 5vh;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.project_download_block {
  height: 5vh;
  width: 5vh;
  border-radius: 50%;
  background-color: #1BD96A;
  border: solid 1px #269556;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 15rpx;
}

.project_follow_false {
  height: 5vh;
  width: 5vh;
  border-radius: 50%;
  background-color: #34363C;
  border: solid 1px #36383E;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 15rpx;
}

.project_follow_true {
  height: 5vh;
  width: 5vh;
  border-radius: 50%;
  background-color: #FF7043;
  border: solid 1px #a0462b;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 15rpx;
}

.project_more_icon {
  height: 5vh;
  width: 5vh;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 15rpx;
}

.project_body_info {
  height: max-content;
  width: 710rpx;
  background-color: #27292E;
  border-radius: 10px;
  border: solid 1px #34363C;
  box-sizing: border-box;
  overflow: hidden;
}

.project_view_type_block {
  height: 5vh;
  width: 710rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 1.1vh;
  margin-top: 1.1vh;
}

.project_view_type_line {
  height: 5vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #27292E;
  border-radius: 2.5vh;
  border: solid 1px #34363C;
}

.project_view_type_description_block {
  color: #ffffff;
  padding-left: 1em;
  padding-right: 1em;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80%;
  border-radius: 50vh;
  margin-left: 0.5em;
}

.project_view_type_description_block_click {
  color: #1BD96A;
  padding-left: 1em;
  padding-right: 1em;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80%;
  border-radius: 50vh;
  background-color: #24553D;
  margin-left: 0.5em;
}

.project_changelog_info {
  height: max-content;
  width: 710rpx;
  background-color: #27292E;
  border-radius: 10px;
  border: solid 1px #34363C;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 5%;
}

.project_changelog_info_block {
  margin-top: 1vh;
  width: 100%;
  height: max-content;
  border-left-style: solid;
  border-left-width: 5px;
  border-radius: 5px;
  overflow: hidden;
  /* 1px  */
}

.release {
  border-color: #00AF5C;
  color: #00AF5C;
}

.alpha {
  border-color: #CB2245;
  color: #CB2245;
}

.beta {
  border-color: #E08325;
  color: #E08325;
}

.search_resource_page_change {
  height: 3.5vh;
  width: 710rpx;
  box-sizing: border-box;
  margin-bottom: 1vh;
  display: inline-flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
}

.search_resource_page_number {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding-left: 1em;
  padding-right: 1em;
  box-sizing: border-box;
  color: #96A2B0;
  height: 3.5vh;
  background-color: #27292E;
  border-radius: 5px;
  border: solid 1px #32343A;
}

.project_version_bolck {
  height: max-content;
  width: 710rpx;
  background-color: #27292E;
  border-radius: 10px;
  overflow: hidden;
  box-sizing: border-box;
  margin-bottom: 1vh;
}

.project_version_line {
  border-bottom: solid 1px #42444A;
  padding: 5%;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  box-sizing: border-box;
  border-bottom: solid 1px #42444A;
}

/* 如果需要最后一项没有下边框 */
.project_version_line:last-child {
  border-bottom: none !important;
}

.project_version_line_first_line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 50%;
  width: 100%;
}

.release_version_icon {
  color: #1BD96A;
  background-color: #244C3A;
}

.beta_version_icon {
  color: #FFA347;
  background-color: #524233;
}

.alpha_version_icon {
  color: #FF496E;
  background-color: #52303B;
}