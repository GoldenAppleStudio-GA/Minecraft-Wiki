          <image src="{{search_resource_list.resourcepack.icon_url}}" style="height: 8vh;width: 8vh;border-radius: 8px;border: solid 1px #32343A;margin-left: 10rpx;">
          </image>
          <view class="mod_provite_data_block_first_line_right_block">
            <view class="mod_provite_data_block_tittle">
              {{search_resource_list.resourcepack.title}}
            </view>
            <view class="mod_provite_data_block_author">
              {{'作者:'+search_resource_list.resourcepack.author}}
            </view>
            <view class="mod_provite_data_block_userinfo">
              <view class="mod_provite_data_block_downloads">
                <image src="/resource/images/download_icon.png" style="height: 1rem;width: 1rem;margin-right: 0.3rem;">
                </image>
                {{search_resource_list.resourcepack.downloads}}
              </view>
              <view class="mod_provite_data_block_downloads" style="margin-left: 0.5rem;">
                <image src="/resource/images/follow_icon.png" style="height: 1rem;width: 1rem;margin-right: 0.3rem;">
                </image>
                {{search_resource_list.resourcepack.follows}}
              </view>
              <view class="mod_provite_data_block_downloads" style="margin-left: 0.5rem;border-radius: 3px;background-color: #34363C;box-sizing: border-box;border: solid 1px #32343A;width: 8em;" catch:tap="copy_resourcepack_id">
                <image src="/resource/images/copy_icon.png" style="height: 1rem;width: 1rem;margin-right: 0.3rem;margin-left: 0.3em;">
                </image>
                {{search_resource_list.resourcepack.project_id}}
              </view>
            </view>
          </view>
        </view>
        <view class="mod_provite_data_block_second_line">
          <view style="font-size: small;">
            简介:
          </view>
          {{search_resource_list.resourcepack.description}}
        </view>
      </view>
    </view>

    <view class="mod_provite">
      <view style="color: #ffffff;font-size: medium;width: 100%;padding-left: 1rem;height: 1em;display: inline-flex;flex-direction: row;align-items: center;justify-content: start;">
        光影包推荐
      </view>
      <view class="mod_provite_data_block">
        <view class="mod_provite_data_block_first_line">
          <image src="{{search_resource_list.shader.icon_url}}" style="height: 8vh;width: 8vh;border-radius: 8px;border: solid 1px #32343A;margin-left: 10rpx;">
          </image>
          <view class="mod_provite_data_block_first_line_right_block">
            <view class="mod_provite_data_block_tittle">
              {{search_resource_list.shader.title}}
            </view>
            <view class="mod_provite_data_block_author">
              {{'作者:'+search_resource_list.shader.author}}
            </view>
            <view class="mod_provite_data_block_userinfo">
              <view class="mod_provite_data_block_downloads">
                <image src="/resource/images/download_icon.png" style="height: 1rem;width: 1rem;margin-right: 0.3rem;">
                </image>
                {{search_resource_list.shader.downloads}}
              </view>
              <view class="mod_provite_data_block_downloads" style="margin-left: 0.5rem;">
                <image src="/resource/images/follow_icon.png" style="height: 1rem;width: 1rem;margin-right: 0.3rem;">
                </image>
                {{search_resource_list.shader.follows}}
              </view>
              <view class="mod_provite_data_block_downloads" style="margin-left: 0.5rem;border-radius: 3px;background-color: #34363C;box-sizing: border-box;border: solid 1px #32343A;width: 8em;" catch:tap="copy_shader_id">
                <image src="/resource/images/copy_icon.png" style="height: 1rem;width: 1rem;margin-right: 0.3rem;margin-left: 0.3em;">
                </image>
                {{search_resource_list.shader.project_id}}
              </view>
            </view>
          </view>
        </view>
        <view class="mod_provite_data_block_second_line">
          <view style="font-size: small;">
            简介:
          </view>
          {{search_resource_list.shader.description}}
        </view>
      </view>
    </view>


  </view>
</view>