    <view class=" page_head_item" style="height: var(--height); margin-top: var(--start);">
      <image src="/resource/images/minecraft_icon_new.png" class="page_head_icon" style="height: var(--height);width:var(--height);"></image>
      <view class="page_head_main_text" style="font-size: calc(var(--height)* 0.7);height:var(--height);margin-left: calc(var(--height) * 0.3);">Minecraft百科</view>
    </view>
  </view>  -->
<!-- 页头-结束 -->
<view id="index_page" class="page">
  <view class="page_head" style="--start:{{app.globalData.page_head_info.start}};--height:{{app.globalData.page_head_info.height}};height: calc(var(--start) + var(--height) * 1.2);">
    <view class=" page_head_item" style="height: var(--height); margin-top: var(--start);">
      <image src="/resource/images/minecraft_icon_new.png" class="page_head_icon" style="height: var(--height);width:var(--height);"></image>
      <view class="page_head_main_text" style="font-size: calc(var(--height)* 0.7);height:var(--height);margin-left: calc(var(--height) * 0.3);">我的世界百科</view>
    </view>
  </view>
  <view class="hidden_block" style="height: {{app.globalData.page_head_info.start_nopx + app.globalData.page_head_info.height_nopx *1.2 + 'px'}};"></view>

  <view class="page_main_view">
    <view class="mod_provite" catch:tap="wiki_click" style="background-color: #00000000;">
      <!-- <view style="color: #ffffff;font-size: medium;width: 100%;height: 1em;display: inline-flex;flex-direction: row;align-items: center;justify-content: start;padding-left: 1.5rem;">
        百科推荐
      </view> -->
      <view class="mod_provite_data_block" style="background-color: #00000000;">
        <view class="mod_provite_data_block_first_line" style="border: none;">
          <image src="{{app.globalData.all_data.init_data.minecraft_data.main[wiki_id].icon_path}}" style="height: 6vh;width: 6vh;border-radius: 5px;box-sizing: border-box;" show-menu-by-longpress="true">
          </image>
          <view class="mod_provite_data_block_first_line_right_block">
            <view class="mod_provite_data_block_tittle">
              {{app.globalData.all_data.init_data.minecraft_data.main[wiki_id].name}}
            </view>
          </view>
          <view class="item_right">
            <image src="/resource/images/next_icon_FFFFFF_px.png" style="height: 1.5em;width: 1.5em;"></image>
          </view>
        </view>
      </view>

    </view>
    <view class="mod_provite" catch:tap="project_mod_click">
      <view style="color: #ffffff;font-size: medium;width: 100%;padding-left: 1.5rem;height: 1em;display: inline-flex;flex-direction: row;align-items: center;justify-content: start;">
        模组推荐
      </view>
      <view class="mod_provite_data_block">
        <view class="mod_provite_data_block_first_line">
          <image src="{{search_resource_list.mod.icon_url}}" style="height: 8vh;width: 8vh;border-radius: 8px;border: solid 1px #32343A;margin-left: 10rpx;" show-menu-by-longpress="true">
          </image>
          <view class="mod_provite_data_block_first_line_right_block">
            <view class="mod_provite_data_block_tittle">
              {{search_resource_list.mod.title}}
            </view>
            <view class="mod_provite_data_block_author">
              {{'作者:'+search_resource_list.mod.author}}
            </view>
            <view class="mod_provite_data_block_userinfo">
              <view class="mod_provite_data_block_downloads">
                <image src="/resource/images/download_icon.png" style="height: 1rem;width: 1rem;margin-right: 0.3rem;">
                </image>
                {{search_resource_list.mod.downloads}}
              </view>
              <view class="mod_provite_data_block_downloads" style="margin-left: 0.5rem;">
                <image src="/resource/images/follow_icon.png" style="height: 1rem;width: 1rem;margin-right: 0.3rem;">
                </image>
                {{search_resource_list.mod.follows}}
              </view>
            </view>
          </view>
        </view>
        <view class="mod_provite_data_block_second_line">
          <view style="font-size: small;">
            简介:
          </view>
          {{search_resource_list.mod.description}}
        </view>
      </view>

    </view>
    <view class="mod_provite" catch:tap="project_modpack_click">
      <view style="color: #ffffff;font-size: medium;width: 100%;padding-left: 1.5rem;height: 1.5em;display: inline-flex;flex-direction: row;align-items: center;justify-content: start;">
        整合包推荐
      </view>
      <view class="mod_provite_data_block">
        <view class="mod_provite_data_block_first_line">
          <image src="{{search_resource_list.modpack.icon_url}}" style="height: 8vh;width: 8vh;border-radius: 8px;border: solid 1px #32343A;margin-left: 10rpx;" show-menu-by-longpress="true">
          </image>
          <view class="mod_provite_data_block_first_line_right_block">
            <view class="mod_provite_data_block_tittle">
              {{search_resource_list.modpack.title}}
            </view>
            <view class="mod_provite_data_block_author">
              {{'作者:'+search_resource_list.modpack.author}}
            </view>
            <view class="mod_provite_data_block_userinfo">
              <view class="mod_provite_data_block_downloads">
                <image src="/resource/images/download_icon.png" style="height: 1rem;width: 1rem;margin-right: 0.3rem;">
                </image>
                {{search_resource_list.modpack.downloads}}
              </view>
              <view class="mod_provite_data_block_downloads" style="margin-left: 0.5rem;">
                <image src="/resource/images/follow_icon.png" style="height: 1rem;width: 1rem;margin-right: 0.3rem;">
                </image>
                {{search_resource_list.modpack.follows}}
              </view>
            </view>
          </view>
        </view>
        <view class="mod_provite_data_block_second_line">
          <view style="font-size: small;">
            简介:
          </view>
          {{search_resource_list.modpack.description}}
        </view>
      </view>
    </view>

    <view class="mod_provite" catch:tap="project_resourcepack_click">
      <view style="color: #ffffff;font-size: medium;width: 100%;padding-left: 1.5rem;height: 1em;display: inline-flex;flex-direction: row;align-items: center;justify-content: start;">
        资源包推荐
      </view>
      <view class="mod_provite_data_block">
        <view class="mod_provite_data_block_first_line">
          <image src="{{search_resource_list.resourcepack.icon_url}}" style="height: 8vh;width: 8vh;border-radius: 8px;border: solid 1px #32343A;margin-left: 10rpx;" show-menu-by-longpress="true">
          </image>
          <view class="mod_provite_data_block_first_line_right_block">
            <view class="mod_provite_data_block_tittle">
              {{search_resource_list.resourcepack.title}}
            </view>
            <view class="mod_provite_data_block_author">
              {{'作者:'+search_resource_list.resourcepack.author}}
            </view>
            <view class="mod_provite_data_block_userinfo">
              <view class="mod_provite_data_block_downloads">
                <image src="/resource/images/download_icon.png" style="height: 1rem;width: 1rem;margin-right: 0.3rem;">
                </image>
                {{search_resource_list.resourcepack.downloads}}
              </view>
              <view class="mod_provite_data_block_downloads" style="margin-left: 0.5rem;">
                <image src="/resource/images/follow_icon.png" style="height: 1rem;width: 1rem;margin-right: 0.3rem;">
                </image>
                {{search_resource_list.resourcepack.follows}}
              </view>
            </view>
          </view>
        </view>
        <view class="mod_provite_data_block_second_line">
          <view style="font-size: small;">
            简介:
          </view>
          {{search_resource_list.resourcepack.description}}
        </view>
      </view>
    </view>

    <view class="mod_provite" catch:tap="project_shader_click">
      <view style="color: #ffffff;font-size: medium;width: 100%;padding-left: 1.5rem;height: 1em;display: inline-flex;flex-direction: row;align-items: center;justify-content: start;">
        光影包推荐
      </view>
      <view class="mod_provite_data_block">
        <view class="mod_provite_data_block_first_line">
          <image src="{{search_resource_list.shader.icon_url}}" style="height: 8vh;width: 8vh;border-radius: 8px;border: solid 1px #32343A;margin-left: 10rpx;" show-menu-by-longpress="true">
          </image>
          <view class="mod_provite_data_block_first_line_right_block">
            <view class="mod_provite_data_block_tittle">
              {{search_resource_list.shader.title}}
            </view>
            <view class="mod_provite_data_block_author">
              {{'作者:'+search_resource_list.shader.author}}
            </view>
            <view class="mod_provite_data_block_userinfo">
              <view class="mod_provite_data_block_downloads">
                <image src="/resource/images/download_icon.png" style="height: 1rem;width: 1rem;margin-right: 0.3rem;">
                </image>
                {{search_resource_list.shader.downloads}}
              </view>
              <view class="mod_provite_data_block_downloads" style="margin-left: 0.5rem;">
                <image src="/resource/images/follow_icon.png" style="height: 1rem;width: 1rem;margin-right: 0.3rem;">
                </image>
                {{search_resource_list.shader.follows}}
              </view>
            </view>
          </view>
        </view>
        <view class="mod_provite_data_block_second_line">
          <view style="font-size: small;">
            简介:
          </view>
          {{search_resource_list.shader.description}}
        </view>
      </view>
    </view>
    <view class="bottom_text">刷到基岩了~</view>
  </view>
</view>