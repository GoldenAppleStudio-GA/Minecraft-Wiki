/**index.wxss**/
.page_main_view {
  width: 750rpx;
  height: max-content;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 2vh;
}

.mod_provite {
  margin-top: 1.5vh;
  width: 710rpx;
  height: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-evenly;

}

.mod_provite_data_block {
  margin-top: 1vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  align-items: center;
  border: solid 1px #32343A;
  background-color: #27292E;
  border-radius: 5px;
  overflow: hidden;
}

.mod_provite_data_block_first_line {
  margin-top: 1vh;
  box-sizing: border-box;
  width: 95% !important;
  flex-wrap: nowrap;
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  border-bottom: solid 1px #34363C;
  padding-bottom: 1vh;
}

.mod_provite_data_block_first_line_right_block {
  margin-left: 15rpx;
  flex-wrap: nowrap;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: max-content;
}

.mod_provite_data_block_tittle {
  width: 500rpx;
  color: #ffffff;
  font-size: x-large;
  white-space: nowrap;
  /* 强制不换行 */
  overflow: hidden;
  /* 隐藏溢出内容 */
  text-overflow: ellipsis;
}

.mod_provite_data_block_author {
  margin-left: 0.5em;
  white-space: nowrap;
  /* 强制不换行 */
  overflow: hidden;
  /* 隐藏溢出内容 */
  text-overflow: ellipsis;
  color: #96A2B0;
  font-size: x-small;
}

.mod_provite_data_block_userinfo {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 1.7rem;
  width: 500rpx;
}

.mod_provite_data_block_downloads {
  margin-left: 0.5em;
  font-size: smaller;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 150rpx;
  width: max-content;
  color: #96A2B0;
}

.mod_provite_data_block_second_line {
  display: flex !important;
  flex-direction: column;
  justify-content: center;
  padding: 0.5em;
  box-sizing: border-box;
  line-height: 1.3em;
  height: auto !important;
  font-weight: 500;
  font-size: medium;
  color: #B0BAC5;
  width: 100%;
  height: 10vh;
}