/* pages/minecraft/minecraft.wxss */
#minecraft_page {

}

.page_main_view {
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 12.8+150 */
  height: 190vh;
}

.page_item {
  display: inline-flex;
  margin-top: 0.8vh;
  width: 720rpx;
  height: 10vh;
  justify-content: space-between;
  background-color: #262423;
}

