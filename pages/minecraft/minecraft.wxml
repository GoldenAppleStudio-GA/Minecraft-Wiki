<!--pages/minecraft/minecraft.wxml-->
<view id="minecraft_page" class="page">
  <view class="page_head">
    <view class="page_head_item">
      <image src="/resource/images/minecraft_icon.png" class="page_head_icon"></image>
      <view class="page_head_text_block">
        <view class="page_head_main_text">Minecraft百科</view>
        <view class="page_head_second_text">Minecraft Wiki</view>
      </view>
    </view>
  </view>
  <view class="hidden_block"></view>
  <scroll-view class="page_main_view" scroll-y="true" enable-flex="true">
    <view wx:for="{{app.globalData.all_data.minecraft_data.main.items}}" wx:key="id" class="page_item" catch:tap="item_click" data-itemid="{{item.id}}">
      <view class="item_left">
        <image src="{{item.icon_path}}" class="item_icon"></image>
        <view class="item_name">{{item.name}}</view>
      </view>
      <view class="item_right">
        <image src="/resource/images/next_icon_FFFFFF_px.png" class="next_icon"></image>
      </view>
    </view>
    <view class="bottom_text">刷到基岩了~</view>
  </scroll-view>
</view>